<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘의 운세 화면 레이아웃 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 가운데 정렬을 위한 컨테이너 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 운세 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFortune"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 카드 내부 컨텐츠 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#E3F2FD">

                <!-- 상단 타이틀 영역 -->
                <TextView
                    android:id="@+id/tvFortuneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘의 운세"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/tvFortuneSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="나의 하루를 한 눈에 보기"
                    android:textSize="13sp"
                    android:textColor="#555555" />

                <!-- 전체 운세 한 줄 요약 -->
                <TextView
                    android:id="@+id/tvFortuneOverall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="오늘 전체 운세가 여기에 표시됩니다."
                    android:textSize="14sp"
                    android:textColor="@android:color/black" />

                <!-- 섹션 구분선 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#BDBDBD" />

                <!-- 카테고리별 운세 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <!-- 금전운 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="금전운"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#37474F" />

                        <TextView
                            android:id="@+id/tvFortuneMoney"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="금전운 내용"
                            android:textSize="13sp"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <!-- 연애운 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="연애운"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#37474F" />

                        <TextView
                            android:id="@+id/tvFortuneLove"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="연애운 내용"
                            android:textSize="13sp"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <!-- 학업·직장운 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="학업·직장"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#37474F" />

                        <TextView
                            android:id="@+id/tvFortuneWorkStudy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="학업·직장운 내용"
                            android:textSize="13sp"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <!-- 건강운 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="건강"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#37474F" />

                        <TextView
                            android:id="@+id/tvFortuneHealth"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="건강운 내용"
                            android:textSize="13sp"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 행운 아이템/컬러 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tvFortuneLucky"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="행운 아이템 / 컬러가 여기에 표시됩니다."
                        android:textSize="13sp"
                        android:textColor="#1E3A8A" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 하단 버튼: 운세 새로고침 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoadFortune"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="오늘의 운세 새로 불러오기"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/cardFortune"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
