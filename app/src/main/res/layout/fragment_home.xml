<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <!-- 전체 스크롤 컨테이너 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- 상단: 선택 키워드 라인 -->
        <TextView
            android:id="@+id/tvUserKeywords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:textSize="13sp"
            android:textColor="@color/primary_blue" />

        <!-- 오늘의 키워드 타이틀 -->
        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="오늘의 키워드"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="4dp" />

        <!-- 키워드 설명 라인 -->
        <TextView
            android:id="@+id/tvKeywordLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="선택한 키워드가 여기에 표시됩니다"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_marginBottom="8dp" />

        <!-- 로딩 인디케이터 -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- 섹션: 경제 주요 토픽 -->
        <TextView
            android:id="@+id/tvSectionTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="경제 주요 토픽"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- 경제 주요 토픽 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginBottom="16dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTopicCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 섹션: AI 추천 종목 -->
        <TextView
            android:id="@+id/tvSectionStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI 추천 종목"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- AI 추천 종목 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginBottom="16dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStockTip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 섹션: 뉴스 -->
        <TextView
            android:id="@+id/tvSectionNews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="뉴스"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- 뉴스 카드 전체 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNewsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 상단: 알약형 토글 탭 (주요 뉴스 / 사용자 맞춤 뉴스) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNewsTabs"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gray_200"
                    android:backgroundTint="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <!-- 왼쪽 탭: 주요 뉴스 -->
                        <TextView
                            android:id="@+id/tvMainNewsTab"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="주요 뉴스"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_news_tab_selected"
                            android:textColor="@android:color/white" />

                        <!-- 오른쪽 탭: 사용자 맞춤 뉴스 -->
                        <TextView
                            android:id="@+id/tvUserNewsTab"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="사용자 맞춤 뉴스"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_news_tab_unselected"
                            android:textColor="@color/gray_500" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 뉴스 리스트: 화면 전체와 같이 스크롤 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvNews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
